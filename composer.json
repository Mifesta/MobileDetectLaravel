{
    "name": "mifesta/mobiledetect-laravel",
    "description": "Detect phones, tablets and crawlers from the current Laravel request.",
    "type": "library",
    "keywords": [
        "laravel",
        "mobile",
        "tablet",
        "bot",
        "crawler",
        "user-agent",
        "detection"
    ],
    "homepage": "https://github.com/Mifesta/MobileDetectLaravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Sergei Gruzdov",
            "email": "cardee@mifesta.com",
            "homepage": "https://github.com/cardee2000",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "cardee@mifesta.com",
        "issues": "https://github.com/Mifesta/MobileDetectLaravel/issues",
        "source": "https://github.com/Mifesta/MobileDetectLaravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0",
        "mifesta/mobiledetect": "^2.5.1"
    },
    "autoload": {
        "psr-4": {
            "MifestaClientBrowserData\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-12.0": "12.0.x-dev"
        },
        "laravel": {
            "providers": [
                "MifestaClientBrowserData\\MobileDetectServiceProvider"
            ],
            "aliases": {
                "MobileDetect": "MifestaClientBrowserData\\Facades\\MobileDetect"
            }
        }
    },
    "scripts": {
        "test": [
            "php tests/run.php",
            "php tests/request.php",
            "php tests/provider.php"
        ]
    }
}
